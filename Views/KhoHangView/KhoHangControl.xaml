<UserControl x:Class="PharmaDistributionApp.Views.ProductView.KhoHangControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F3F5F9" FontFamily="{DynamicResource MaterialDesignFont}"
             MouseDown="UserControl_MouseDown" Focusable="True">
    <UserControl.Resources>
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" CornerRadius="18" BorderThickness="1" BorderBrush="#4C70BA" Background="White">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#888"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#4C70BA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="bdr" Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#4C70BA"/>
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundedBtn" TargetType="Button">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#888"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BellBtnStyle" TargetType="ToggleButton">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4C70BA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#6B92D8"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEE"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="25" Background="Transparent" MouseDown="UserControl_MouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Quản lý kho hàng" FontSize="32" FontWeight="Bold" Foreground="#4C70BA" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,15,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,15,0" VerticalAlignment="Center">
                    <Grid>
                        <ToggleButton x:Name="btnBell" Width="40" Height="40" Padding="0" Style="{StaticResource BellBtnStyle}" Click="BtnThongBao_Click">
                            <Grid>
                                <materialDesign:PackIcon Width="30" Height="30" Foreground="#4C70BA" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="BellOutline"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, ElementName=btnBell}" Value="True">
                                                    <Setter Property="Kind" Value="Bell"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                                <Border x:Name="bdBadge" Background="#D32F2F" CornerRadius="10" Height="18" MinWidth="18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10,-2,-2,0" BorderBrush="White" BorderThickness="1.5" IsHitTestVisible="False" Visibility="Collapsed">
                                    <TextBlock x:Name="txtCountBadge" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="2,0"/>
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="popThongBao" PlacementTarget="{Binding ElementName=btnBell}" Placement="Bottom" IsOpen="{Binding IsChecked, ElementName=btnBell, Mode=TwoWay}" StaysOpen="False" HorizontalOffset="-460" VerticalOffset="5" AllowsTransparency="True" PopupAnimation="Slide">
                            <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#DDD" Width="500" MaxHeight="400">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.2" Direction="270"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="50"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="#FFEBEE" CornerRadius="8,8,0,0">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0">
                                                <materialDesign:PackIcon Kind="WarningCircle" Foreground="#D32F2F" Width="24" Height="24" VerticalAlignment="Center"/>
                                                <TextBlock Text="Cảnh báo hệ thống" Foreground="#D32F2F" FontWeight="Bold" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button HorizontalAlignment="Right" Margin="0,0,10,0" Width="30" Height="30" Background="Transparent" BorderThickness="0" Click="BtnDongPopup_Click">
                                                <materialDesign:PackIcon Kind="Close" Foreground="#D32F2F"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                    <DataGrid Grid.Row="1" x:Name="dgvCanhBao" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" BorderThickness="0" RowHeaderWidth="0" MouseLeftButtonUp="dgvCanhBao_MouseLeftButtonUp">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mã SP" Binding="{Binding Masp}" Width="80" FontWeight="Bold" Foreground="#4C70BA"/>
                                            <DataGridTextColumn Header="Nội dung" Binding="{Binding Message}" Width="*">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding WarningColor}"/>
                                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Kho" Binding="{Binding TenKho}" Width="100"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
                <Border Background="White" CornerRadius="22" BorderThickness="0" Height="44" Width="300" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="#40000000" Opacity="0.5" BlurRadius="8"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray" FontSize="16"/>
                        <TextBox x:Name="txtTimKiem" materialDesign:TextFieldAssist.UnderlineBrush="#4C70BA" CaretBrush="#4C70BA" SelectionBrush="#4C70BA" SelectionOpacity="0.3" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Margin="45,0,15,0" FontSize="14" materialDesign:HintAssist.Hint="Tìm kiếm..." materialDesign:HintAssist.IsFloating="False" Foreground="Gray" TextChanged="txtTimKiem_TextChanged"/>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="BtnXuatExcel" Content="📊 Xuất excel" Height="44" Width="130" Margin="0,0,10,0" Style="{StaticResource RoundedBtn}" Background="White" Foreground="#4C70BA" BorderBrush="#4C70BA" BorderThickness="1" FontWeight="SemiBold" FontSize="14" Click="BtnXuatExcel_Click"/>
                <Button x:Name="BtnNhapHang" Content="+   Tạo phiếu" Height="44" Width="130" Style="{StaticResource RoundedBtn}" Background="#4C70BA" Foreground="White" BorderThickness="0" FontWeight="Bold" FontSize="14" Click="BtnNhapHang_Click"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <RadioButton x:Name="RadTonKho" Content="Tồn kho" GroupName="ViewMode" IsChecked="True" Style="{StaticResource TabButtonStyle}" Checked="Filter_Checked"/>
            <RadioButton x:Name="RadPhieuNhap" Content="Phiếu nhập" GroupName="ViewMode" Style="{StaticResource TabButtonStyle}" Checked="Filter_Checked"/>
            <RadioButton x:Name="RadPhieuXuat" Content="Phiếu xuất" GroupName="ViewMode" Style="{StaticResource TabButtonStyle}" Checked="Filter_Checked"/>
        </StackPanel>
        <Border Grid.Row="4" Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" Padding="0" ClipToBounds="True">
            <DataGrid x:Name="dgvKhoHang" AutoGenerateColumns="False" CanUserSortColumns="True" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" VerticalGridLinesBrush="Transparent" Background="White" BorderThickness="0" RowHeaderWidth="0" RowHeight="50" MouseDoubleClick="dgvKhoHang_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã sản phẩm" Binding="{Binding Masp}" Width="120">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#4C70BA"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Tensp}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Padding" Value="10,0,0,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Đơn vị" Binding="{Binding Dvt}" Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Kho" Binding="{Binding TenKho}" Width="100"/>
                    <DataGridTextColumn Header="Số Lô" Binding="{Binding SoHieuLo}" Width="90"/>
                    <DataGridTextColumn Header="Hạn Dùng" Binding="{Binding HSD}" Width="100"/>
                    <DataGridTextColumn Header="Tồn Kho" Binding="{Binding SoLuongTon}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Trạng thái" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding MauNenTrangThai}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TenTrangThai}" Foreground="{Binding MauChuTrangThai}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Thao tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand" Click="BtnHanhDong_Click">
                                    <TextBlock Text="⋮" FontSize="24" FontWeight="Bold" Foreground="#888" Margin="0,-8,0,0"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>