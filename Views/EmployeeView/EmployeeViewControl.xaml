<UserControl x:Class="PharmaDistributionApp.Views.EmployeeView.EmployeeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             
             xmlns:services="clr-namespace:PharmaDistributionApp.Services"
             
             Background="#F5F5F5"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <services:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>

        <BitmapImage x:Key="DefaultAvatarImage" UriSource="/Images/default_avatar.jpg" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QUẢN LÝ NHÂN VIÊN" 
                           FontSize="28" FontWeight="Bold" Foreground="#4C70BA"
                           Effect="{StaticResource MaterialDesignShadowDepth1}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Danh sách nhân sự và thông tin liên hệ" 
                               FontSize="14" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=dgEmployee, Path=SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Click="btnEdit_Click" Height="40" Margin="0,0,10,0"
                            BorderBrush="#1976D2" Foreground="#1976D2"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            ToolTip="Chỉnh sửa nhân viên đang chọn">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Pencil" Margin="0,0,5,0"/>
                            <TextBlock Text="Sửa"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                            Height="40" Click="btnDelete_Click"
                            BorderBrush="#D32F2F" Foreground="#D32F2F"
                            materialDesign:ButtonAssist.CornerRadius="20"
                            ToolTip="Xóa nhân viên đang chọn">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="DeleteOutline" Margin="0,0,5,0"/>
                            <TextBlock Text="Xóa"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border Background="White" CornerRadius="20" Margin="0,0,15,0" Effect="{StaticResource MaterialDesignShadowDepth1}">
                    <Grid Width="250" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Foreground="Gray" VerticalAlignment="Center" Margin="10,0"/>

                        <TextBox x:Name="txtSearch" 
                                 TextChanged="txtSearch_TextChanged" 
                                 Grid.Column="1" 
                                 materialDesign:HintAssist.Hint="Tìm kiếm..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 BorderThickness="0" VerticalContentAlignment="Center"
                                 Background="Transparent"/>
                    </Grid>
                </Border>

                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="btnExportExcel_Click" Height="40" Margin="0,0,10,0"
                        BorderBrush="#4C70BA" Foreground="#4C70BA"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        ToolTip="Xuất dữ liệu ra Excel">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExcelOutline" Margin="0,0,5,0"/>
                        <TextBlock Text="Xuất Excel"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="btnAdd_Click" Height="40" Background="#4C70BA" BorderBrush="{x:Null}"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        ToolTip="Thêm nhân viên mới">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,5,0"/>
                        <TextBlock Text="Thêm mới" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Effect="{StaticResource MaterialDesignShadowDepth2}">

            <DataGrid x:Name="dgEmployee"
                      ItemsSource="{Binding Employees}" 
                      SelectedItem="{Binding SelectedEmployee}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      Cursor="Hand"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"     
                      GridLinesVisibility="None"
                      HorizontalGridLinesBrush="#EEEEEE"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="60"
                      ScrollViewer.CanContentScroll="True" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="Foreground" Value="#4C70BA"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,2"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>

                    <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Background="{TemplateBinding Background}" 
                                            SnapsToDevicePixels="True">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="40" Height="40" CornerRadius="20" BorderBrush="Gray" BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <Binding Path="AvatarBlob" 
                                                         Converter="{StaticResource ByteArrayToImageConverter}"
                                                         TargetNullValue="{StaticResource DefaultAvatarImage}"/>
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Mã NV" Binding="{Binding Manv}"
                                        IsReadOnly="True"
                                        FontWeight="Bold" Width="100" Foreground="#4C70BA">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding Tennv}" 
                                        Width="250" IsReadOnly="True" FontWeight="SemiBold" Foreground="#333333">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" 
                                        Width="100" IsReadOnly="True" Foreground="#555555">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Chức vụ" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD" CornerRadius="15" Padding="15,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Chucvu}" Foreground="#1565C0" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Trạng thái" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="{Binding TrangThaiMau}"/>
                                            <Setter Property="Background" Value="Transparent"/>

                                        </Style>
                                    </Border.Style>

                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Circle" Width="8" Height="8" Margin="0,0,6,0" 
                                             VerticalAlignment="Center"
                                             Foreground="{Binding TrangThaiMau}"/>

                                        <TextBlock Text="{Binding TrangThaiHienThi}" 
                               Foreground="{Binding TrangThaiMau}" 
                               FontWeight="SemiBold"
                               FontSize="12"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>