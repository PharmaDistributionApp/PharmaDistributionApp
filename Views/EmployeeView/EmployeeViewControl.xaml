<UserControl x:Class="PharmaDistributionApp.Views.EmployeeView.EmployeeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:PharmaDistributionApp.Services" 
             Background="#F3F5F9" 
             FontFamily="{DynamicResource MaterialDesignFont}"
             MouseDown="UserControl_MouseDown"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <services:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <BitmapImage x:Key="DefaultAvatarImage" UriSource="/Images/default_avatar.jpg" />

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4C70BA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#6B92D8"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" 
                        BorderThickness="{TemplateBinding BorderThickness}" 
                        BorderBrush="{TemplateBinding BorderBrush}" 
                        Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="55"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEE"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedBtn" TargetType="Button">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">

                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" 
                                                  BlurRadius="5" 
                                                  ShadowDepth="1" 
                                                  Direction="270" 
                                                  Opacity="0.3" 
                                                  Color="#888"/>
                            </Border.Effect>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="15" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="4" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="5" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QUẢN LÝ NHÂN VIÊN" 
                           FontSize="32" FontWeight="Bold" Foreground="#4C70BA"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Danh sách nhân sự, chức vụ và trạng thái hoạt động" 
                               FontSize="14" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="White" CornerRadius="22" Height="44" Width="300" Margin="0,0,10,0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" Direction="270" Color="#40000000" Opacity="0.5" BlurRadius="8"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray" FontSize="16"/>
                        <TextBox x:Name="txtSearch" GotFocus="txtSearch_GotFocus"
                                 TextChanged="txtSearch_TextChanged"
                                  materialDesign:TextFieldAssist.UnderlineBrush="#4C70BA"
                                 BorderThickness="0" Background="Transparent" 
                                 VerticalContentAlignment="Center" Margin="45,0,15,0"
                                 FontSize="14"
                                 materialDesign:HintAssist.Hint="Tìm kiếm nhân viên..."
                                 materialDesign:HintAssist.IsFloating="False"/>
                    </Grid>
                </Border>

                <Button x:Name="btnExportExcel" Click="btnExportExcel_Click" 
                        Foreground="White"
                        Style="{StaticResource RoundedBtn}"
                        Background="#217346" 
                        BorderBrush="{x:Null}"  
                        Height="45" 
                        Margin="0,0,10,0"
                        FontSize="14">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <materialDesign:PackIcon Kind="FileExcel" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Xuất Excel" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnAddNew" Click="btnAdd_Click" 
                       Content="+ Thêm mới" Height="44" Width="130"
                        Style="{StaticResource RoundedBtn}"
                        Background="#4C70BA" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" FontSize="14">
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" 
                BorderBrush="#DDD" BorderThickness="1" ClipToBounds="True">
            <DataGrid x:Name="dgEmployee"
                      ItemsSource="{Binding Employees}" 
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EEEEEE"
                      CanUserSortColumns="False"
                      VerticalGridLinesBrush="Transparent"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="White"
                      RowHeaderWidth="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Cursor="Hand"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="40" Height="40" CornerRadius="20" BorderBrush="#DDD" BorderThickness="1" Margin="5">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill" 
                                                   ImageSource="{Binding AvatarBlob, Converter={StaticResource ByteArrayToImageConverter}, TargetNullValue={StaticResource DefaultAvatarImage}}"/>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Mã NV" Binding="{Binding Manv}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Foreground" Value="#4C70BA"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding Tennv}" Width="*" FontWeight="Bold">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="10,0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Chức vụ" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD" CornerRadius="15" Padding="15,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Chucvu}" Foreground="#1565C0" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Trạng thái" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="stBorder" CornerRadius="15" BorderThickness="1" Height="30" Width="130">
                                    <TextBlock x:Name="stText" Text="{Binding TrangThaiHienThi}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="12"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding TrangThaiHienThi}" Value="Đang hoạt động">
                                        <Setter TargetName="stBorder" Property="Background" Value="#E8F5E9"/>
                                        <Setter TargetName="stBorder" Property="BorderBrush" Value="#2E7D32"/>
                                        <Setter TargetName="stText" Property="Foreground" Value="#2E7D32"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrangThaiHienThi}" Value="Tạm nghỉ">
                                        <Setter TargetName="stBorder" Property="Background" Value="#FFF3E0"/>
                                        <Setter TargetName="stBorder" Property="BorderBrush" Value="#EF6C00"/>
                                        <Setter TargetName="stText" Property="Foreground" Value="#EF6C00"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TrangThaiHienThi}" Value="Đã nghỉ việc">
                                        <Setter TargetName="stBorder" Property="Background" Value="#FFEBEE"/>
                                        <Setter TargetName="stBorder" Property="BorderBrush" Value="#C62828"/>
                                        <Setter TargetName="stText" Property="Foreground" Value="#C62828"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thao tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Center" Cursor="Hand" Click="BtnHanhDong_Click">
                                    <TextBlock Text="⋮" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="0,-8,0,0"/>
                                    <Button.ContextMenu>
                                        <ContextMenu Background="White" BorderThickness="0">
                                            <ContextMenu.Template>
                                                <ControlTemplate TargetType="ContextMenu">
                                                    <Border Background="White" CornerRadius="8" BorderThickness="1" BorderBrush="#EEEEEE" Padding="5">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                                                        </Border.Effect>
                                                        <StackPanel IsItemsHost="True"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ContextMenu.Template>
                                            <MenuItem Header="Chỉnh sửa" Click="BtnSua_Click" Foreground="#4C70BA" FontWeight="Bold" FontSize="14" Height="40">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#4C70BA"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Xóa" Click="BtnXoa_Click" Foreground="#D32F2F" FontWeight="Bold" FontSize="14" Height="40">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#D32F2F"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>