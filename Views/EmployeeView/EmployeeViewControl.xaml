<UserControl x:Class="PharmaDistributionApp.Views.EmployeeView.EmployeeViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:services="clr-namespace:PharmaDistributionApp.Services" 
             Background="#F3F5F9" 
             FontFamily="{DynamicResource MaterialDesignFont}"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <services:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <BitmapImage x:Key="DefaultAvatarImage" UriSource="/Images/default_avatar.jpg" />

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4C70BA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="Wheat"/>
        </Style>

        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="Foreground" Value="Black"/>

            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" 
                                BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EEE"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F5F5F5"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundedBtn" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="QUẢN LÝ NHÂN VIÊN" 
                           FontSize="28" FontWeight="Bold" Foreground="#4C70BA"
                           Effect="{StaticResource MaterialDesignShadowDepth1}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="Gray" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="Danh sách nhân sự và thông tin liên hệ" 
                               FontSize="14" Foreground="Gray"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=dgEmployee, Path=SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                </StackPanel>

                <Border Background="White" CornerRadius="20" Margin="0,0,15,0" Effect="{StaticResource MaterialDesignShadowDepth1}">
                    <Grid Width="250" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Foreground="Gray" VerticalAlignment="Center" Margin="10,0"/>

                        <TextBox x:Name="txtSearch" 
                                 TextChanged="txtSearch_TextChanged" 
                                 Grid.Column="1" 
                                 materialDesign:HintAssist.Hint="Tìm kiếm..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 BorderThickness="0" VerticalContentAlignment="Center"
                                 Background="Transparent"/>
                    </Grid>
                </Border>

                <Button Content="📊 Xuất excel" 
                        Height="44" Width="130" Margin="0,0,10,0"
                        Style="{StaticResource RoundedBtn}"
                        Background="White" Foreground="#4C70BA" 
                        BorderBrush="#4C70BA" BorderThickness="1"
                        FontWeight="SemiBold" FontSize="14"
                        Click="btnExportExcel_Click"
                        ToolTip="Xuất dữ liệu ra Excel"/>

                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="btnAdd_Click" Height="40" Background="#4C70BA" BorderBrush="{x:Null}"
                        materialDesign:ButtonAssist.CornerRadius="20"
                        ToolTip="Thêm nhân viên mới">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,5,0"/>
                        <TextBlock Text="Thêm mới" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="White" CornerRadius="12" 
        BorderBrush="#DDD" BorderThickness="1" ClipToBounds="True">

            <DataGrid x:Name="dgEmployee"
                      ItemsSource="{Binding Employees}" 
                      SelectedItem="{Binding SelectedEmployee}"
                      MouseDoubleClick="DataGrid_MouseDoubleClick"
                      Cursor="Hand"
                      AutoGenerateColumns="False" 
                      CanUserAddRows="False"
                      CanUserSortColumns="False"
                      CanUserReorderColumns="False"
                      HeadersVisibility="Column"     
                      GridLinesVisibility="Vertical"
                      HorizontalGridLinesBrush="#EEEEEE"
                      Background="White"
                      BorderThickness="0"
                      ScrollViewer.CanContentScroll="True" 
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>

                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="40" Height="40" CornerRadius="20" BorderBrush="Gray" BorderThickness="1">
                                    <Border.Background>
                                        <ImageBrush Stretch="UniformToFill">
                                            <ImageBrush.ImageSource>
                                                <Binding Path="AvatarBlob" 
                                                         Converter="{StaticResource ByteArrayToImageConverter}"
                                                         TargetNullValue="{StaticResource DefaultAvatarImage}"/>
                                            </ImageBrush.ImageSource>
                                        </ImageBrush>
                                    </Border.Background>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Mã NV" Binding="{Binding Manv}"
                                        IsReadOnly="True"
                                        FontWeight="Bold" Width="100" Foreground="#4C70BA">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Họ và Tên" Binding="{Binding Tennv}" 
                                        Width="250" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Padding" Value="5,0"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Giới tính" Binding="{Binding GioiTinh}" 
                                        Width="100" IsReadOnly="True" Foreground="#555555">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Chức vụ" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#E3F2FD" CornerRadius="15" Padding="15,5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Chucvu}" Foreground="#1565C0" FontWeight="Bold" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Trạng thái" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="16" BorderThickness="1" 
                                        Height="32" Width="140"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                            <Setter Property="BorderBrush" Value="Gray"/>
                                            <Setter Property="TextBlock.Foreground" Value="Gray"/>

                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrangThaiHienThi}" Value="Đang hoạt động">
                                                    <Setter Property="Background" Value="#E8F5E9"/>
                                                    <Setter Property="BorderBrush" Value="#2E7D32"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#2E7D32"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding TrangThaiHienThi}" Value="Tạm nghỉ">
                                                    <Setter Property="Background" Value="#FFF3E0"/>
                                                    <Setter Property="BorderBrush" Value="#EF6C00"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#EF6C00"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding TrangThaiHienThi}" Value="Đã nghỉ việc">
                                                    <Setter Property="Background" Value="#FFEBEE"/>
                                                    <Setter Property="BorderBrush" Value="#C62828"/>
                                                    <Setter Property="TextBlock.Foreground" Value="#C62828"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock Text="{Binding TrangThaiHienThi}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontWeight="Bold"
                                               FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thao tác" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Background="Transparent" BorderThickness="0" 
                                        HorizontalAlignment="Center" Cursor="Hand" 
                                        Click="BtnHanhDong_Click">
                                    <TextBlock Text="⋮" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="0,-8,0,0"/>

                                    <Button.ContextMenu>
                                        <ContextMenu Background="White" BorderThickness="0">
                                            <ContextMenu.Template>
                                                <ControlTemplate TargetType="ContextMenu">
                                                    <Border Background="White" CornerRadius="8" 
                                                            BorderThickness="1" BorderBrush="#EEEEEE" Padding="5">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                                                        </Border.Effect>
                                                        <StackPanel IsItemsHost="True"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ContextMenu.Template>

                                            <MenuItem Header="Chỉnh sửa" Click="BtnSua_Click" 
                                                      Foreground="#4C70BA" FontWeight="Bold" FontSize="14" Height="40">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Pencil" Foreground="#4C70BA"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                            <MenuItem Header="Xóa" Click="BtnXoa_Click" 
                                                      Foreground="#D32F2F" FontWeight="Bold" FontSize="14" Height="40">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="DeleteOutline" Foreground="#D32F2F"/>
                                                </MenuItem.Icon>
                                            </MenuItem>

                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>