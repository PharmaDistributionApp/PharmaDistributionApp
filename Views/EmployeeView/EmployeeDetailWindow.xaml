<Window x:Class="PharmaDistributionApp.Views.EmployeeView.EmployeeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        
        xmlns:local="clr-namespace:PharmaDistributionApp" 
        
        Title="Hồ sơ chi tiết nhân viên" Height="518" Width="800"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="WhiteSmoke">

    <Window.Resources>
        <BitmapImage x:Key="DefaultAvatar" UriSource="/PharmaDistributionApp;component/Images/default_avatar.jpg" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Top">

            <Border BorderBrush="#888" BorderThickness="1" Background="White" 
                    Width="200" Height="260" Margin="0,0,0,15">

                <Image Stretch="Uniform" VerticalAlignment="Center">
                    <Image.Source>
                        <Binding Path="AvatarSource" TargetNullValue="{StaticResource DefaultAvatar}" />
                    </Image.Source>
                </Image>
            </Border>

            <TextBlock Text="CHỨC VỤ" Foreground="Gray" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Chucvu}" 
                       HorizontalAlignment="Center" Margin="0,2,0,10"
                       FontSize="18" FontWeight="Bold" Foreground="#d35400" 
                       TextWrapping="Wrap" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock Text="Mã NV: " Foreground="Gray" FontSize="14"/>
                <TextBlock Text="{Binding Manv}" FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="30,0,0,0">

            <TextBlock Text="HỌ VÀ TÊN" Foreground="Gray" FontSize="12"/>
            <TextBlock Text="{Binding Tennv}" 
                       FontSize="30" FontWeight="Bold" Foreground="#2c3e50" 
                       Margin="0,0,0,20"/>

            <Separator Margin="0,0,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Giới tính:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="15"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding GioiTinh}" VerticalAlignment="Center" FontSize="15"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ngày sinh:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="15"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Ngaysinh, StringFormat='dd/MM/yyyy'}" VerticalAlignment="Center" FontSize="15"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Số điện thoại:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="15"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Sdt}" VerticalAlignment="Center" FontSize="15" FontWeight="Medium"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Email:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="15"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Email}" VerticalAlignment="Center" FontSize="15" FontStyle="Italic" Foreground="Blue"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Số CCCD:" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="15"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Cccd}" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Địa chỉ:" FontWeight="SemiBold" VerticalAlignment="Top" Margin="0,12,0,0" FontSize="15"/>
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Diachi}" 
                           TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,12,0,0" 
                           FontSize="15" LineHeight="24"/>
            </Grid>

            <Button Content="Đóng Hồ Sơ" Width="150" Height="40" 
                    HorizontalAlignment="Center" Margin="0,30,0,0"
                    Background="#4C70BA" 
                    Foreground="White" 
                    BorderThickness="0"
                    FontSize="14" FontWeight="SemiBold"
                    Click="Button_Close_Click" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="20"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>