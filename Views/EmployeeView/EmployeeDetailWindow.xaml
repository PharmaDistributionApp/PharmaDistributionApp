<Window x:Class="PharmaDistributionApp.Views.EmployeeView.EmployeeDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:services="clr-namespace:PharmaDistributionApp.Services" 
        Title="Hồ sơ chi tiết nhân viên" Height="580" Width="850"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" WindowStyle="None" AllowsTransparency="True"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <services:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
        <BitmapImage x:Key="DefaultAvatar" UriSource="/Images/default_avatar.jpg" />

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="SelectableInfoValueStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" Padding="0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="30" BorderBrush="#4C70BA" BorderThickness="2" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#4C70BA" CornerRadius="28,28,0,0" MouseDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Information" Foreground="White" Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="THÔNG TIN CHI TIẾT NHÂN VIÊN" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="30,25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <Border Width="190" Height="190" CornerRadius="95" Background="White" BorderBrush="#4C70BA" BorderThickness="2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.15"/>
                        </Border.Effect>
                        <Border CornerRadius="95" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill" 
                                            ImageSource="{Binding AvatarBlob, Converter={StaticResource ByteArrayToImageConverter}, TargetNullValue={StaticResource DefaultAvatar}}"/>
                            </Border.Background>
                        </Border>
                    </Border>

                    <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                        <TextBlock Text="MÃ NHÂN VIÊN" Style="{StaticResource InfoLabelStyle}" HorizontalAlignment="Center" FontSize="11"/>
                        <TextBox Text="{Binding Manv}" Style="{StaticResource SelectableInfoValueStyle}" 
                                 FontSize="22" FontWeight="Bold" Foreground="#4C70BA" HorizontalContentAlignment="Center"/>

                        <Border Background="#E3F2FD" CornerRadius="15" Padding="18,6" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Chucvu}" Foreground="#1565C0" FontWeight="Bold" FontSize="14"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Column="1" Margin="30,0,0,0" Height="431" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,25">
                        <TextBox Text="{Binding Tennv}" Style="{StaticResource SelectableInfoValueStyle}" FontSize="28" FontWeight="Bold"/>
                        <Separator Background="#EEEEEE" Margin="0,12,0,0" Height="1"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="45"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Giới tính:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding GioiTinh}" Style="{StaticResource SelectableInfoValueStyle}"/>

                        <TextBlock Grid.Row="1" Text="Ngày sinh:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Ngaysinh, StringFormat='dd/MM/yyyy'}" Style="{StaticResource SelectableInfoValueStyle}"/>

                        <TextBlock Grid.Row="2" Text="Số điện thoại:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Sdt}" Style="{StaticResource SelectableInfoValueStyle}" FontWeight="Bold"/>

                        <TextBlock Grid.Row="3" Text="Số CCCD:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Cccd}" Style="{StaticResource SelectableInfoValueStyle}"/>

                        <TextBlock Grid.Row="4" Text="Email:" Style="{StaticResource InfoLabelStyle}"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Email}" Style="{StaticResource SelectableInfoValueStyle}" Foreground="#1565C0"/>

                        <TextBlock Grid.Row="5" Text="Địa chỉ:" Style="{StaticResource InfoLabelStyle}" 
                        VerticalAlignment="Top" Margin="0,12,0,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Diachi}" 
                        Style="{StaticResource SelectableInfoValueStyle}" 
                        VerticalAlignment="Top" Margin="0,12,0,0"
                        TextWrapping="Wrap" AcceptsReturn="True"/>
                    </Grid>

                    <Button Grid.Row="2" Content="Đóng" Width="120" Height="42" HorizontalAlignment="Right"
                            Background="#4C70BA" Foreground="White" BorderThickness="0" IsCancel="True"
                            Click="Button_Close_Click" Cursor="Hand" materialDesign:ButtonAssist.CornerRadius="8"/>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>