<Window x:Class="PharmaDistributionApp.Views.ProductView.ChiTietSanPhamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chi tiết sản phẩm" Height="480" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" Background="Transparent" AllowsTransparency="True"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Border Background="White" CornerRadius="20" BorderBrush="#4C70BA" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="65"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="75"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#4C70BA" CornerRadius="18,18,0,0" MouseDown="Border_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="InformationOutline" 
                                     Foreground="White" 
                                     Width="25" 
                                     Height="25" 
                                     VerticalAlignment="Center" 
                                     Margin="0,0,10,0"/>
                        <TextBlock Text="THÔNG TIN CHI TIẾT" 
                       Foreground="White" 
                       FontSize="18" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center"/>
                    </StackPanel>

                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="35,20">
                <StackPanel>
                    <TextBlock x:Name="lblTenSP" Text="Tên sản phẩm..." FontSize="22" 
                               FontWeight="Bold" Foreground="#4C70BA" TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="38"/>
                            <RowDefinition Height="50"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã sản phẩm:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#777"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="txtMaSP" Text="..." VerticalAlignment="Center" FontSize="14" FontWeight="Bold"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Loại thuốc:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#777"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="txtLoai" Text="..." VerticalAlignment="Center" FontSize="14"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Đơn vị tính:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#777"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="txtDVT" Text="..." VerticalAlignment="Center" FontSize="14"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Nước sản xuất:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#777"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="txtNuocSX" Text="..." VerticalAlignment="Center" FontSize="14"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Nhà cung cấp:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#777"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="txtNhaCungCap" Text="..." VerticalAlignment="Center" Foreground="#4C70BA" FontWeight="Bold" FontSize="14"/>

                        <Separator Grid.Row="5" Grid.ColumnSpan="2" VerticalAlignment="Top" Margin="0,5" Background="#EEE"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Giá bán niêm yết:" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#777"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="txtGiaBan" Text="0 đ" VerticalAlignment="Center" Foreground="#D32F2F" FontWeight="Bold" FontSize="20"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Button Grid.Row="2" Content="Đóng" Width="100" Margin="0,0,20,20"
                    Background="#4C70BA" BorderBrush="#4C70BA" Foreground="White"
                    HorizontalAlignment="Right" Click="BtnThoat_Click" IsCancel="True">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>