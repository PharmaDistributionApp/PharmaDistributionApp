<Window x:Class="PharmaDistributionApp.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Quên mật khẩu" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#90B0D5" CornerRadius="20,0,0,20"/>

        <Border Grid.Column="1" Background="White" 
                CornerRadius="30,0,20,0" Margin="-30,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" Margin="60,0">

                <TextBlock Text="Đặt lại mật khẩu của bạn" 
                           FontSize="28" FontWeight="Bold" Foreground="#4267B2" Margin="0,0,0,10"/>

                <TextBlock Text="Vui lòng nhập địa chỉ email đã dùng để tạo tài khoản." 
                           Foreground="#90B0D5" TextWrapping="Wrap" Margin="0,0,0,30" FontSize="14"/>

                <TextBlock Text="Email" Foreground="Gray" Margin="0,0,0,5"/>
                <TextBox x:Name="txtRecoveryEmail"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.IsFloating="False"
                         materialDesign:HintAssist.Hint="nhapemail@gmail.com"
                         BorderBrush="#DDDDDD" Padding="10" Height="50" FontSize="14"
                         TextChanged="txtRecoveryEmail_TextChanged"/>
                <StackPanel x:Name="pnlErrorMessage" Orientation="Horizontal" Margin="5,5,0,0" Visibility="Collapsed">
                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="Red" VerticalAlignment="Center" Width="15" Height="15"/>
                    <TextBlock Text="Vui lòng nhập Email" Foreground="Red" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnSend" Content="Gửi" Margin="0,40,0,0"
                        Height="50" FontSize="18" FontWeight="Bold" 
                        Background="#4C70BA" BorderBrush="{x:Null}"
                        Click="btnSend_Click">
                    <Button.Resources>
                        <CornerRadius x:Key="ButtonCornerRadius">25</CornerRadius>
                    </Button.Resources>
                </Button>

                <Button Content="Quay lại Đăng nhập" 
                        Style="{StaticResource MaterialDesignFlatButton}" 
                        Foreground="Gray" Margin="0,15,0,0"
                        Click="btnBackToLogin_Click"/>

            </StackPanel>
        </Border>
        <Button Grid.Column="1"
            HorizontalAlignment="Right" 
            VerticalAlignment="Top"
            Margin="0,10,15,0"
            Width="30" Height="30"
            Style="{StaticResource MaterialDesignIconForegroundButton}"
            ToolTip="Thoát ứng dụng"
            Click="btnExit_Click">

            <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="Gray"/>
        </Button>
    </Grid>
</Window>