<UserControl x:Class="PharmaDistributionApp.Views.LoginControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <StackPanel VerticalAlignment="Center" Margin="40,0">
        <TextBlock Text="Đăng nhập" FontSize="32" FontWeight="Bold" Foreground="#4267B2" Margin="0,0,0,30"/>

        <TextBox x:Name="txtUsername"
                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                 materialDesign:HintAssist.IsFloating="True"
                 materialDesign:HintAssist.Hint="ID / Tên tài khoản"
                 BorderBrush="#DDDDDD" Padding="10" Height="50" FontSize="14">
            <TextBox.Resources>
                <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#4C70BA"/>
            </TextBox.Resources>
        </TextBox>

        <PasswordBox x:Name="txtPassword"
                     Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                     materialDesign:HintAssist.IsFloating="True"
                     materialDesign:HintAssist.Hint="Mật khẩu"
                     BorderBrush="#DDDDDD" Padding="10" Height="50" FontSize="14"
                     Margin="0,15,0,0">
            <PasswordBox.Resources>
                <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#4C70BA"/>
            </PasswordBox.Resources>
        </PasswordBox>

        <Grid Margin="0,15">
            <CheckBox x:Name="chkRemember" 
                      Content="Ghi nhớ đăng nhập" 
                      Style="{StaticResource MaterialDesignCheckBox}" 
                      Foreground="#333"/>
            
            <TextBlock Text="Quên mật khẩu" HorizontalAlignment="Right" Foreground="#4267B2" Cursor="Hand" MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
        </Grid>

        <TextBlock x:Name="txbErrorMessage" Text="Sai tài khoản hoặc mật khẩu" Foreground="Red" FontSize="14" Visibility="Collapsed" Margin="0,0,0,10"/>

        <Button x:Name="btnLogin" 
                IsDefault="True"
                Content="Đăng Nhập" Height="50" FontSize="18" FontWeight="Bold" Background="#4C70BA" BorderBrush="{x:Null}" Click="btnLogin_Click">
            <Button.Resources>
                <CornerRadius x:Key="ButtonCornerRadius">10</CornerRadius>
            </Button.Resources>
        </Button>
    </StackPanel>
</UserControl>