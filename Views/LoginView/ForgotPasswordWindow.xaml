<UserControl x:Class="PharmaDistributionApp.Views.ForgotPasswordWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="500"
             Background="White"
             FontFamily="{DynamicResource MaterialDesignFont}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="40,0">

            <TextBlock Text="ĐẶT LẠI MẬT KHẨU" 
                       FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Foreground="#4C70BA"
                       Margin="0,0,0,10"/>

            <TextBlock Text="Vui lòng nhập địa chỉ email đã dùng để tạo tài khoản." 
                       Foreground="Gray" TextWrapping="Wrap" 
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,30" FontSize="14"/>

            <TextBox x:Name="txtRecoveryEmail"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Email khôi phục"
                     materialDesign:TextFieldAssist.LeadingIcon="Email"
                     Height="50" FontSize="14"
                     Margin="0,0,0,5"
                     TextChanged="txtRecoveryEmail_TextChanged">

                <TextBox.Resources>
                    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#4C70BA"/>
                </TextBox.Resources>

            </TextBox>
            <StackPanel x:Name="pnlErrorMessage" Orientation="Horizontal" Margin="5,5,0,0" Visibility="Collapsed">
                <materialDesign:PackIcon Kind="AlertCircle" Foreground="Red" VerticalAlignment="Center" Width="15" Height="15"/>

                <TextBlock x:Name="txbErrorContent" 
                           Text="Thông báo lỗi hiển thị ở đây" 
                           Foreground="Red" 
                           FontSize="12" 
                           Margin="5,0,0,0" 
                           VerticalAlignment="Center"/>
            </StackPanel>
            <Button x:Name="btnSend" 
                    IsDefault="True"
                    Content="GỬI MÃ XÁC NHẬN" 
                    Margin="0,30,0,0"
                    Height="50" 
                    FontSize="16" 
                    FontWeight="Bold" 
                    Background="#4C70BA" 
                    BorderBrush="{x:Null}"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Click="btnSend_Click"/>

            <Button Content="Quay lại Đăng nhập" 
                    Style="{StaticResource MaterialDesignFlatButton}" 
                    Foreground="#4C70BA" 
                    Margin="0,15,0,0"
                    Click="btnBackToLogin_Click"/>

        </StackPanel>
    </Grid>
</UserControl>