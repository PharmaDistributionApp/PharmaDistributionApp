<UserControl x:Class="PharmaDistributionApp.Views.ChangePasswordControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="White"
             Width="400" Height="450"
             FontFamily="{DynamicResource MaterialDesignFont}">

    <UserControl.Resources>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignPasswordBox}">
            <Setter Property="Margin" Value="0,10,0,20"/>
            <Setter Property="Padding" Value="5"/>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="10" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,30">
                <materialDesign:PackIcon Kind="LockOutline" Width="25" Height="25" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="THAY ĐỔI MẬT KHẨU" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Mật khẩu hiện tại" FontWeight="SemiBold"/>
                <PasswordBox x:Name="pbOldPass" materialDesign:HintAssist.Hint="*******"/>

                <TextBlock Text="Mật khẩu mới" FontWeight="SemiBold"/>
                <PasswordBox x:Name="pbNewPass" materialDesign:HintAssist.Hint="*******"/>

                <TextBlock Text="Xác nhận mật khẩu" FontWeight="SemiBold"/>
                <PasswordBox x:Name="pbConfirmPass" materialDesign:HintAssist.Hint="*******"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnCancel" Click="btnCancel_Click"
                        Grid.Column="0" Content="Hủy"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        BorderBrush="#DDDDDD" Foreground="#666"/>

                <Button x:Name="btnSave" Click="btnSave_Click"
                        Grid.Column="2" Content="Đổi mật khẩu"
                        Background="#4C70BA" BorderBrush="{x:Null}"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>