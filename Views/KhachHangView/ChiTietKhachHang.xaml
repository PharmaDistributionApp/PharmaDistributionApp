<Window x:Class="PharmaDistributionApp.Views.KhachHangView.ChiTietKhachHang"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chi tiết khách hàng" Height="700" Width="660"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        FontFamily="Segoe UI"
        MouseDown="Window_MouseDown">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueStyle">
            <Setter Property="Foreground" Value="#2D3436"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StaticHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4C70BA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="BorderBrush" Value="#6B92D8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="15" BorderThickness="1" BorderBrush="#EEEEEE">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.15" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#4C70BA" CornerRadius="14,14,0,0" Height="55" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountBox" Foreground="White" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="HỒ SƠ KHÁCH HÀNG" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnDong_Click" Style="{StaticResource MaterialDesignIconForegroundButton}" Foreground="White" Margin="0,0,10,0">
                        <materialDesign:PackIcon Kind="Close"/>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="25,20,25,10">
                <TextBlock x:Name="lblTenKH" Text="TÊN KHÁCH HÀNG" Foreground="#4C70BA" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>

                <Border Background="#F8F9FA" CornerRadius="10" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã khách hàng:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblMaKH" Text="..." Style="{StaticResource ValueStyle}"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Số điện thoại:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" x:Name="lblSdt" Text="..." Style="{StaticResource ValueStyle}" Foreground="#ff2d3436"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Email:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblEmail" Text="..." Style="{StaticResource ValueStyle}" ToolTip="{Binding Text, ElementName=lblEmail}"/>

                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Loại khách hàng:" Style="{StaticResource LabelStyle}"/>
                        <Border Grid.Row="2" Grid.Column="4" Background="#E8F5E9" CornerRadius="4" HorizontalAlignment="Left" Padding="8,2">
                            <TextBlock x:Name="lblLoaiKH" Text="..." FontWeight="Bold" Foreground="#2E7D32" FontSize="12"/>
                        </Border>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Địa chỉ:" Style="{StaticResource LabelStyle}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="lblDiaChi" Text="..." Style="{StaticResource ValueStyle}" Grid.ColumnSpan="4"/>
                    </Grid>
                </Border>
            </StackPanel>

            <Grid Grid.Row="2" Margin="25,10,25,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <materialDesign:PackIcon Kind="History" Foreground="#4C70BA" VerticalAlignment="Center" Margin="0,0,8,0" Width="20" Height="20"/>
                    <TextBlock Text="Lịch sử mua hàng (Hóa đơn xuất)" FontWeight="Bold" FontSize="15" Foreground="#4C70BA"/>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dgHoadon" 
                          AutoGenerateColumns="False" CanUserAddRows="False" 
                          CanUserSortColumns="False" 
                          IsReadOnly="True" Background="White" 
                          BorderThickness="1" BorderBrush="#EEE"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#FAFAFA"
                          ColumnHeaderStyle="{StaticResource StaticHeaderStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã HĐ" Binding="{Binding Sohdxuat}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#4C70BA"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Ngày lập" Binding="{Binding Ngaylap}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding Tongtien, StringFormat={}{0:N0} VND}" Width="*">

                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="Medium"/>
                                    <Setter Property="Margin" Value="0,0,20,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>

                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaticHeaderStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="Trạng thái" Width="130">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StaticHeaderStyle}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Trangthai}" Value="Đã thanh toán">
                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Trangthai}" Value="Chờ thanh toán">
                                                        <Setter Property="Background" Value="#FFF3E0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Trangthai}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Trangthai}" Value="Đã thanh toán">
                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Trangthai}" Value="Chờ thanh toán">
                                                            <Setter Property="Foreground" Value="#EF6C00"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Margin="0,15,0,0" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="0,15,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="TỔNG DOANH SỐ TÍCH LŨY: " FontWeight="Bold" Foreground="Black" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="lblTongDoanhSo" Text="0 VND" FontWeight="Bold" FontSize="18" Foreground="#D32F2F" VerticalAlignment="Bottom" Margin="5,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3" Background="#F8F9FA" CornerRadius="0,0,14,14" Padding="20,15">
                <Button Content="ĐÓNG" Click="BtnDong_Click" Width="140" Height="40" 
                        Background="#4C70BA" Foreground="White" FontWeight="Bold" FontSize="14"
                        BorderThickness="0" materialDesign:ButtonAssist.CornerRadius="20">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3" Color="#4C70BA"/>
                    </Button.Effect>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>