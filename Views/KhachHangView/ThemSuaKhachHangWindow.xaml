<Window x:Class="PharmaDistributionApp.Views.KhachHangView.ThemSuaKhachHangWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Thông tin khách hàng" Height="500" Width="450"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="White" FontFamily="Segoe UI">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Text="THÊM KHÁCH HÀNG MỚI" 
                   HorizontalAlignment="Center" Foreground="#4F7CC9" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <TextBox x:Name="txtMaKH" materialDesign:HintAssist.Hint="Mã khách hàng" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

            <TextBox x:Name="txtTenKH" materialDesign:HintAssist.Hint="Tên khách hàng" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

            <TextBox x:Name="txtSdt" materialDesign:HintAssist.Hint="Số điện thoại" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

            <TextBox x:Name="txtEmail" materialDesign:HintAssist.Hint="Email" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>

            <ComboBox x:Name="cbLoaiKH" materialDesign:HintAssist.Hint="Loại khách hàng" 
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15">
                <ComboBoxItem Content="Khách lẻ"/>
                <ComboBoxItem Content="Nhà thuốc"/>
                <ComboBoxItem Content="Đại lý"/>
            </ComboBox>

            <TextBox x:Name="txtDiaChi" materialDesign:HintAssist.Hint="Địa chỉ" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                     TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" Click="BtnHuy_Click" IsCancel="True"
                    Width="100" Margin="0,0,10,0" Style="{StaticResource MaterialDesignOutlinedButton}"/>

            <Button Content="Lưu" Click="BtnLuu_Click" IsDefault="True"
                    Width="100" Background="#4F7CC9" BorderBrush="#4F7CC9"/>
        </StackPanel>
    </Grid>
</Window>