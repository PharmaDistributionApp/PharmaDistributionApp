<UserControl x:Class="PharmaDistributionApp.Views.ResetPasswordWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="White"
             FontFamily="{DynamicResource MaterialDesignFont}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <UserControl.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="80,0">

            <TextBlock Text="ĐỔI MẬT KHẨU" 
                       FontSize="28" FontWeight="Bold" Foreground="#4267B2" 
                       Margin="0,0,0,30" HorizontalAlignment="Left"/>

            <TextBlock Text="Nhập mật khẩu mới" Style="{StaticResource LabelTextStyle}"/>
            <PasswordBox x:Name="txtNewPassword"
                         Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                         materialDesign:HintAssist.Hint="************"
                         BorderBrush="#DDDDDD" Padding="10" Height="50" FontSize="14"
                         Margin="0,0,0,20"
                         PasswordChanged="txtNewPassword_PasswordChanged"/>

            <TextBlock Text="Xác nhận mật khẩu" Style="{StaticResource LabelTextStyle}"/>
            <PasswordBox x:Name="txtConfirmPassword"
                         Style="{StaticResource MaterialDesignOutlinedRevealPasswordBox}"
                         materialDesign:HintAssist.Hint="************"
                         BorderBrush="#DDDDDD" Padding="10" Height="50" FontSize="14"
                         PasswordChanged="txtConfirmPassword_PasswordChanged"/>

            <Button x:Name="btnSave" Content="LƯU THAY ĐỔI" Margin="0,40,0,0"
                    Height="50" FontSize="16" FontWeight="Bold" 
                    Background="#4C70BA" BorderBrush="{x:Null}"
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Click="btnSave_Click"/>

        </StackPanel>
    </Grid>
</UserControl>