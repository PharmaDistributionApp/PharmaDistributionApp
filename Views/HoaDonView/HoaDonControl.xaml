<UserControl x:Class="PharmaDistributionApp.Views.Controls.HoaDonControl"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             Background="#FFFFFF"
             FontFamily="{DynamicResource MaterialDesignFont}"
             TextElement.Foreground="#333333">

    <UserControl.Resources>
        <Style x:Key="LightHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#4C70BA"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style x:Key="CenterCell" TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="RightCell" TargetType="DataGridCell" BasedOn="{StaticResource CenterCell}">
            <Setter Property="TextBlock.TextAlignment" Value="Right"/>
        </Style>
        <Style x:Key="LeftCell" TargetType="DataGridCell" BasedOn="{StaticResource CenterCell}">
            <Setter Property="TextBlock.TextAlignment" Value="Left"/>
        </Style>
        <Style x:Key="RoundedBtn" TargetType="Button">
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect x:Name="shadow" BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#888"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-4" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="15" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="4" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="BlurRadius" To="5" Duration="0:0:0.2"/>
                                        <DoubleAnimation Storyboard.TargetName="shadow" Storyboard.TargetProperty="ShadowDepth" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" Background="Transparent" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Hóa đơn" FontSize="32" FontWeight="Bold" Foreground="#4C70BA" VerticalAlignment="Center"/>

            <Border Grid.Column="1" CornerRadius="20" BorderBrush="#DDDDDD" BorderThickness="1" Height="40" Margin="40,0" Background="White" MaxWidth="600">
                <Grid>
                    <materialDesign:PackIcon Kind="Magnify" Foreground="Gray" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    <TextBox x:Name="txtSearch" TextChanged="txtSearch_TextChanged" materialDesign:HintAssist.Hint="Tìm kiếm..." materialDesign:TextFieldAssist.DecorationVisibility="Hidden" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" Margin="45,0,15,0" FontSize="14"/>
                </Grid>
            </Border>

            <Grid x:Name="gridNotification" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                <ToggleButton x:Name="btnNoti" Width="40" Height="40" Background="Transparent" BorderBrush="Transparent" Padding="0" Style="{StaticResource MaterialDesignActionToggleButton}">
                    <materialDesign:PackIcon Kind="Bell" Width="28" Height="28" Foreground="#666"/>
                </ToggleButton>
                <Border x:Name="bdBadge" Width="18" Height="18" CornerRadius="9" Background="#E53E3E" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="txtBadgeCount" Text="0" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <Popup x:Name="popNotifications" PlacementTarget="{Binding ElementName=btnNoti}" IsOpen="{Binding IsChecked, ElementName=btnNoti}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Slide">
                    <Border Background="White" CornerRadius="8" BorderBrush="#DDD" BorderThickness="1" Width="420" MaxHeight="520">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.2" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="15,12" Background="#F8F9FA" CornerRadius="8,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="BellRing" Foreground="#4C70BA" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Yêu cầu cần xử lý" FontWeight="Bold" Foreground="#4C70BA" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <ListBox x:Name="lvPendingInvoices" Grid.Row="1" BorderThickness="0" MouseDoubleClick="lvPendingInvoices_MouseDoubleClick" Background="Transparent" MaxHeight="450" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="border" Background="White" BorderBrush="#F5F5F5" BorderThickness="0,0,0,1">
                                                        <Grid Margin="15,12">
                                                            <ContentPresenter/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#F0F7FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding MaHD}" FontWeight="Bold" Foreground="#333" FontSize="15" VerticalAlignment="Center"/>
                                                    <Border Margin="10,0,0,0" CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding LoaiHD}" Value="Nhập">
                                                                        <Setter Property="Background" Value="#E3F2FD"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LoaiHD}" Value="Xuất">
                                                                        <Setter Property="Background" Value="#E8F5E9"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding LoaiHD}" Value="Yêu cầu XÓA">
                                                                        <Setter Property="Background" Value="#FFEBEE"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding LoaiHD}" FontSize="10" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding LoaiHD}" Value="Nhập">
                                                                            <Setter Property="Foreground" Value="#1565C0"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding LoaiHD}" Value="Xuất">
                                                                            <Setter Property="Foreground" Value="#2E7D32"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding LoaiHD}" Value="Yêu cầu XÓA">
                                                                            <Setter Property="Foreground" Value="#C62828"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding DoiTac}" FontSize="13" Foreground="#666" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="CalendarClock" Width="12" Height="12" Foreground="#999" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding NgayLap, StringFormat='dd/MM/yyyy HH:mm'}" FontSize="11" Foreground="#999"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding TongTienString}" FontWeight="Bold" Foreground="#E53E3E" FontSize="15" HorizontalAlignment="Right" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding TrangThai}" FontSize="11" Foreground="#F57C00" FontStyle="Italic" FontWeight="Medium" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>

            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">

                <Button x:Name="btnExportExcel" 
                        Click="btnExportExcel_Click" 
                        Foreground="White"
                        Style="{StaticResource RoundedBtn}"
                        Background="#217346" 
                        BorderBrush="{x:Null}"  
                        Height="45" 
                        Margin="0,0,10,0"
                        FontSize="14">
                    <StackPanel Orientation="Horizontal" Margin="15,0">
                        <materialDesign:PackIcon Kind="FileExcel" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Xuất Excel" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnAddNew" 
                        Click="btnAddNew_Click"
                        Content="+ Thêm mới" 
                        Height="45" Width="130"
                        Style="{StaticResource RoundedBtn}" 
                        Background="#4C70BA" Foreground="White" BorderThickness="0"
                        FontWeight="Bold" FontSize="14"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="btnTabNhap" Click="Tab_Click" Tag="Nhap" Content="Nhập hàng" Height="36" Width="130" Margin="0,0,10,0" materialDesign:ButtonAssist.CornerRadius="18" Background="White" BorderBrush="#4C70BA" BorderThickness="1" Foreground="#4C70BA" FontWeight="Bold"/>
                <Button x:Name="btnTabXuat" Click="Tab_Click" Tag="Xuat" Content="Xuất hàng" Height="36" Width="130" materialDesign:ButtonAssist.CornerRadius="18" Background="#4C70BA" BorderBrush="#4C70BA" BorderThickness="1" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="btnToggleFilter" Click="btnToggleFilter_Click" Height="36" Margin="0,0,10,0" Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" BorderBrush="#AAAAAA" Foreground="#333" Padding="15,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilterVariant" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Bộ lọc" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ComboBox x:Name="cbbSortCriteria" SelectionChanged="cbbSortCriteria_SelectionChanged" Height="36" Width="150" Margin="0,0,10,0" Padding="10,0" VerticalContentAlignment="Center" materialDesign:HintAssist.Hint="Tiêu chí xếp" Style="{StaticResource MaterialDesignOutlinedComboBox}" BorderBrush="#AAAAAA">
                    <ComboBoxItem Content="Tên đối tác" Tag="Ten"/>
                    <ComboBoxItem Content="Ngày lập" Tag="NgayLap" IsSelected="True"/>
                    <ComboBoxItem Content="Tổng tiền" Tag="TongTien"/>
                </ComboBox>
                <Button x:Name="btnSortDirection" Click="btnSortDirection_Click" Height="36" Width="45" Style="{StaticResource MaterialDesignOutlinedButton}" materialDesign:ButtonAssist.CornerRadius="8" BorderBrush="#AAAAAA" Foreground="#4C70BA" Padding="0">
                    <materialDesign:PackIcon x:Name="iconSort" Kind="SortCalendarDescending" Width="20" Height="20"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border x:Name="FilterPanel" Grid.Row="2" Visibility="Collapsed" Background="#FAFAFA" BorderBrush="#EEEEEE" BorderThickness="1" CornerRadius="8" Padding="15,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <ComboBox x:Name="cbbMonth" Width="90" Height="50" Margin="0,0,10,0" materialDesign:HintAssist.Hint="Tháng" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                <ComboBox x:Name="cbbYear" Width="100" Height="50" Margin="0,0,25,0" materialDesign:HintAssist.Hint="Năm" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,25,0" Width="280">
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Giá tối đa (VNĐ)" FontSize="10" Foreground="Gray" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtSliderValue" TextChanged="txtSliderValue_TextChanged" Width="120" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignTextBox}" HorizontalContentAlignment="Right" FontWeight="Bold" Foreground="#4C70BA" FontSize="13" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE"/>
                    </Grid>
                    <Slider x:Name="sldPrice" ValueChanged="sldPrice_ValueChanged" Minimum="0" Maximum="100000000" Foreground="#4C70BA"/>
                </StackPanel>
                <ComboBox x:Name="cbbStatus" Width="150" Height="50" Margin="0,0,25,0" materialDesign:HintAssist.Hint="Trạng thái" Style="{StaticResource MaterialDesignOutlinedComboBox}" VerticalAlignment="Center" Padding="8,4"/>
                <Button x:Name="btnApplyFilter" Click="btnApplyFilter_Click" Content="Áp dụng" Height="40" Background="#4C70BA" BorderBrush="{x:Null}" Margin="0,0,10,0" Width="90"/>
                <Button x:Name="btnResetFilter" Click="btnResetFilter_Click" Content="Hủy bỏ" Height="40" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#E0E0E0" Foreground="Gray" Width="90"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
            <DataGrid x:Name="dgHoaDon" CanUserSortColumns="False" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="dgHoaDon_MouseDoubleClick" HeadersVisibility="Column" Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" ColumnHeaderStyle="{StaticResource LightHeaderStyle}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Mã HĐ" Width="120" CellStyle="{StaticResource CenterCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MaHD}" FontWeight="Bold" Foreground="#4C70BA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding DoiTac}" Width="*" CellStyle="{StaticResource LeftCell}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Ngày lập" Binding="{Binding NgayLap, StringFormat=dd/MM/yyyy}" Width="150" CellStyle="{StaticResource CenterCell}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTienString}" Width="150" CellStyle="{StaticResource RightCell}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTemplateColumn Header="Trạng thái" Width="180" CellStyle="{StaticResource CenterCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="15" Padding="12,5" HorizontalAlignment="Center" BorderThickness="1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F5F5F5"/>
                                            <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Đã thanh toán">
                                                    <Setter Property="Background" Value="#F0FFF4"/>
                                                    <Setter Property="BorderBrush" Value="#C6F6D5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Chờ thanh toán">
                                                    <Setter Property="Background" Value="#FFF9E5"/>
                                                    <Setter Property="BorderBrush" Value="#FFE0B2"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Đã hủy">
                                                    <Setter Property="Background" Value="#FFF5F5"/>
                                                    <Setter Property="BorderBrush" Value="#FED7D7"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding TrangThai}" Value="Yêu cầu xóa">
                                                    <Setter Property="Background" Value="#FFF5F5"/>
                                                    <Setter Property="BorderBrush" Value="#FED7D7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding TrangThai}" FontWeight="SemiBold" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#718096"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã thanh toán">
                                                        <Setter Property="Foreground" Value="#2F855A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Chờ thanh toán">
                                                        <Setter Property="Foreground" Value="#D97706"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Đã hủy">
                                                        <Setter Property="Foreground" Value="#C53030"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TrangThai}" Value="Yêu cầu xóa">
                                                        <Setter Property="Foreground" Value="#C53030"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Thao tác" Width="100" CellStyle="{StaticResource CenterCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges" HorizontalAlignment="Center" Foreground="Gray" Background="Transparent" BorderThickness="0" Padding="4">
                                    <materialDesign:PopupBox.ToggleContent>
                                        <materialDesign:PackIcon Kind="DotsVertical" Width="24" Height="24"/>
                                    </materialDesign:PopupBox.ToggleContent>
                                    <StackPanel Width="150">
                                        <Button Click="btnEdit_Click" Tag="{Binding}" 
        Style="{StaticResource MaterialDesignFlatButton}"
        Visibility="{Binding ElementName=Root, Path=UserActionVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Pencil" Margin="0,0,10,0" Foreground="#4C70BA"/>
                                                <TextBlock Text="Sửa"/>
                                            </StackPanel>
                                        </Button>

                                        <Button Click="btnDelete_Click" Tag="{Binding}" 
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Visibility="{Binding ElementName=Root, Path=UserActionVisibility}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Delete" Margin="0,0,10,0" Foreground="#E53E3E"/>
                                                <TextBlock Text="Xóa"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="btnPrint_Click" Tag="{Binding}" Style="{StaticResource MaterialDesignFlatButton}" Height="Auto" Padding="10,8" HorizontalContentAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,10,0" Foreground="#D32F2F"/>
                                                <TextBlock Text="Xuất PDF"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </materialDesign:PopupBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>