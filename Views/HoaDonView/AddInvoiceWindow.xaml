<Window x:Class="PharmaDistributionApp.Views.AddInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Thêm Hóa Đơn Mới" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" ResizeMode="CanResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#4C70BA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style x:Key="PillRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#4C70BA"/>
            <Setter Property="BorderBrush" Value="#4C70BA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="130"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#4C70BA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="TẠO HÓA ĐƠN" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0"/>
                    <TextBlock Text="Nhập thông tin giao dịch mới" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="rbNhap" Content="Nhập hàng" GroupName="Type" Style="{StaticResource PillRadioButton}" Margin="0,0,10,0" Checked="InvoiceType_Checked"/>
                    <RadioButton x:Name="rbXuat" Content="Xuất hàng" GroupName="Type" Style="{StaticResource PillRadioButton}" IsChecked="True" Checked="InvoiceType_Checked"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid Margin="15,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã Hóa Đơn" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtMaHD" IsReadOnly="True" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngày lập" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNgayLap" IsReadOnly="True"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Nhân viên" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNhanVien" IsReadOnly="True"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Trạng thái" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboTrangThai">
                            <ComboBoxItem Content="Đã thanh toán" IsSelected="True"/>
                            <ComboBoxItem Content="Chờ thanh toán"/>
                        </ComboBox>
                    </StackPanel>

                    <Grid Grid.Row="2" Grid.ColumnSpan="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblDoiTac" Text="Khách hàng" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cboDoiTac" DisplayMemberPath="Display" SelectedValuePath="Value" IsEditable="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ghi chú" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtGhiChu"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid Margin="15,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="0.7*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <TextBlock Text="Sản phẩm" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                                <TextBlock x:Name="lblTonKho" Text="Tồn: 0" FontSize="11" Foreground="#4C70BA" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            <ComboBox x:Name="cboSanPham" DisplayMemberPath="TenSP" SelectionChanged="cboSanPham_SelectionChanged" IsEditable="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Quy cách" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtQuyCach" Text="1" PreviewTextInput="NumberValidationTextBox" HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Số lượng đặt" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Height="36" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnMinus" Click="btnMinus_Click" Content="-" Background="Transparent" BorderBrush="{x:Null}" Foreground="#555" FontWeight="Bold" FontSize="18" Padding="0" Cursor="Hand"/>
                                    <TextBox Grid.Column="1" x:Name="txtSoLuong" Text="0" PreviewTextInput="NumberValidationTextBox" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontWeight="Bold"/>
                                    <Button Grid.Column="2" x:Name="btnPlus" Click="btnPlus_Click" Content="+" Background="Transparent" BorderBrush="{x:Null}" Foreground="#4C70BA" FontWeight="Bold" FontSize="18" Padding="0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Đơn giá" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtDonGia" IsReadOnly="True" HorizontalContentAlignment="Right" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Column="8" Content="THÊM" Click="btnThemSP_Click" VerticalAlignment="Bottom" Height="36" Width="80"
                                Background="{StaticResource PrimaryBlue}" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <Grid x:Name="pnlNhapHang" Grid.Row="1" Margin="0,15,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngày sản xuất" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                                <DatePicker x:Name="dpNSX"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Hạn sử dụng" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                                <DatePicker x:Name="dpHSD"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Tách lô (SL)" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtSoLoTach" Text="1" PreviewTextInput="NumberValidationTextBox" 
                                         HorizontalContentAlignment="Center" FontWeight="Bold" TextChanged="txtSoLoTach_TextChanged"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Mã quản lý hệ thống sẽ tạo tự động:" Foreground="#4C70BA" FontSize="11" FontStyle="Italic" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtMaLoList" Height="60" Background="#F9FAFB" BorderBrush="#EEEEEE"
                                         VerticalContentAlignment="Top" Padding="5" TextWrapping="Wrap" AcceptsReturn="True" 
                                         VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontSize="11" FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <DataGrid Grid.Row="3" x:Name="dgChiTiet" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MinHeight="250"
                      Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                      HeadersVisibility="Column" RowBackground="White" AlternatingRowBackground="#FAFAFA" RowHeight="40">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4C70BA"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Height" Value="45"/>
                        <Setter Property="BorderBrush" Value="White"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SP" Binding="{Binding MaSP}" Width="90"/>
                    <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding TenSP}" Width="*"/>
                    <DataGridTextColumn Header="Mã Lô" Binding="{Binding MaLo}" Width="180" Foreground="#666"/>
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding DonVi}" Width="70"/>
                    <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="80"/>
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0} VND}" Width="140"/>
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0} VND}" Width="160"/>
                    <DataGridTemplateColumn Header="Thao tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xóa" Click="btnXoaSP_Click" Background="Transparent" Foreground="#E53E3E" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="4" Background="White" Margin="0,15,0,0" Padding="15,12" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Tiền hàng:" Width="110" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtTienHang" Text="0 VND" FontWeight="Bold" Foreground="#333"/>
                        </StackPanel>
                        <StackPanel x:Name="pnlVAT" Orientation="Horizontal" Margin="0,0,0,6" Visibility="Collapsed">
                            <TextBlock Text="VAT (10%):" Width="110" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtVAT" Text="0 VND" FontWeight="Bold" Foreground="#4C70BA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TỔNG CỘNG:" Width="110" FontSize="14" FontWeight="Bold" Foreground="#444" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTongCong" Text="0 VND" FontSize="22" FontWeight="Bold" Foreground="#E53E3E" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="Hủy bỏ" Click="btnHuy_Click" Width="100" Height="40" Margin="0,0,10,0" Background="#F1F3F5" Foreground="#555" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="LƯU HÓA ĐƠN" Click="btnLuu_Click" Width="160" Height="40" Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>