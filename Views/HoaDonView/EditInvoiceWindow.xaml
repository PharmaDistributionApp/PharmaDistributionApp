<Window x:Class="PharmaDistributionApp.Views.EditInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Chỉnh sửa hóa đơn" Height="450" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="CHỈNH SỬA THÔNG TIN" FontSize="20" FontWeight="Bold" Foreground="#4C70BA" HorizontalAlignment="Center" Margin="0,0,0,20"/>
        <StackPanel Grid.Row="1">
            <TextBox x:Name="txtMaHD" materialDesign:HintAssist.Hint="Mã hóa đơn" IsReadOnly="True" Margin="0,0,0,15" FontWeight="Bold"/>
            <DatePicker x:Name="dpNgayLap" materialDesign:HintAssist.Hint="Ngày lập" Margin="0,0,0,15" Style="{StaticResource MaterialDesignFloatingHintDatePicker}"/>
            <ComboBox x:Name="cbbDoiTac" materialDesign:HintAssist.Hint="Đối tác" Margin="0,0,0,15" Style="{StaticResource MaterialDesignFloatingHintComboBox}" DisplayMemberPath="Ten" SelectedValuePath="Ma"/>
            <TextBox x:Name="txtGhiChu" materialDesign:HintAssist.Hint="Ghi chú" Margin="0,0,0,15" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Lưu" Click="btnSave_Click" Width="100" Margin="0,0,10,0" Background="#4C70BA"/>
            <Button x:Name="btnCancel" Content="Hủy" Click="btnCancel_Click" Width="80" Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </StackPanel>
    </Grid>
</Window>