<Window x:Class="PharmaDistributionApp.Views.EditInvoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Chỉnh Sửa Hóa Đơn" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" ResizeMode="CanResize"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Regular"
        TextElement.FontSize="13"
        FontFamily="{DynamicResource MaterialDesignFont}"
        MouseDown="Window_MouseDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBlue" Color="#4C70BA"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E0E0E0"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#EAEAEA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000" Direction="270" ShadowDepth="2" Opacity="0.05" BlurRadius="8"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style x:Key="RightAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,10,0"/>
        </Style>

        <Style x:Key="CenterAlignCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="CHỈNH SỬA HÓA ĐƠN" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlue}" Margin="0"/>
                    <TextBlock Text="Cập nhật thông tin và hàng hóa" FontSize="13" Foreground="Gray" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" x:Name="bdLoaiHD" Background="#E3F2FD" CornerRadius="18" Padding="20,0" Height="36">
                    <TextBlock x:Name="lblLoaiHD" Text="HÓA ĐƠN XUẤT" FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid Margin="15,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="15"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Mã Hóa Đơn" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtMaHD" IsReadOnly="True" FontWeight="Bold" Foreground="#333" Background="#F5F5F5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngày lập" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNgayLap" IsReadOnly="True" Background="#F5F5F5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Nhân viên" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <TextBox x:Name="txtNhanVien" IsReadOnly="True" Background="#F5F5F5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Trạng thái" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cboTrangThai">
                            <ComboBoxItem Content="Đã thanh toán" IsSelected="True"/>
                            <ComboBoxItem Content="Chờ thanh toán"/>
                        </ComboBox>
                    </StackPanel>

                    <Grid Grid.Row="2" Grid.ColumnSpan="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="lblDoiTac" Text="Khách hàng" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <ComboBox x:Name="cboDoiTac" DisplayMemberPath="Display" SelectedValuePath="Value" IsEditable="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ghi chú" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtGhiChu"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid Margin="15,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.0*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Grid>
                                <TextBlock Text="Thêm sản phẩm bổ sung" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                                <TextBlock x:Name="lblTonKho" Text="Tồn: 0" FontSize="11" Foreground="#4C70BA" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                            <ComboBox x:Name="cboSanPham" DisplayMemberPath="TenSP" SelectionChanged="cboSanPham_SelectionChanged" IsEditable="True"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Số lượng" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <Border BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Height="36" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnMinus" Click="btnMinus_Click" Content="-" Background="Transparent" BorderBrush="{x:Null}" Foreground="#555" FontWeight="Bold" FontSize="18" Padding="0" Cursor="Hand"/>
                                    <TextBox Grid.Column="1" x:Name="txtSoLuong" Text="0" PreviewTextInput="NumberValidationTextBox" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" FontWeight="Bold"/>
                                    <Button Grid.Column="2" x:Name="btnPlus" Click="btnPlus_Click" Content="+" Background="Transparent" BorderBrush="{x:Null}" Foreground="#4C70BA" FontWeight="Bold" FontSize="18" Padding="0" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Đơn giá" FontWeight="SemiBold" Foreground="#666" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtDonGia" IsReadOnly="True" Focusable="False" HorizontalContentAlignment="Right" FontWeight="Bold" Foreground="#333" Background="#F8F9FA"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="THÊM" Click="btnThemSP_Click" Height="36" Width="80"
                                    Background="{StaticResource PrimaryBlue}" Foreground="White" 
                                    BorderThickness="0" FontWeight="Bold" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button x:Name="btnUndo" Click="btnUndo_Click" Height="36" Width="50" Margin="10,0,0,0" ToolTip="Hoàn tác"
                                    Background="White" BorderBrush="{StaticResource PrimaryBlue}" BorderThickness="1" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                                <Path Data="M 12,6 L 7,11 L 12,16 M 7,11 H 15 C 19,11 22,14 22,18"
                                      Stroke="{StaticResource PrimaryBlue}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <DataGrid Grid.Row="3" x:Name="dgChiTiet" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                      MinHeight="250" MaxHeight="450" 
                      Background="White" BorderBrush="{StaticResource BorderColor}" BorderThickness="1"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F0F0"
                      HeadersVisibility="Column" RowBackground="White" AlternatingRowBackground="#FAFAFA" RowHeight="40"
                      VerticalScrollBarVisibility="Auto"
                      CanUserSortColumns="False">

                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#4C70BA"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="Height" Value="45"/>
                        <Setter Property="BorderBrush" Value="White"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="BorderBrush" Value="#4C70BA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã SP" Binding="{Binding MaSP}" Width="90" ElementStyle="{StaticResource CenterAlignCell}"/>
                    <DataGridTextColumn Header="Tên Sản Phẩm" Binding="{Binding TenSP}" Width="*"/>
                    <DataGridTextColumn Header="Mã Lô" Binding="{Binding MaLo}" Width="150" Foreground="#666" ElementStyle="{StaticResource CenterAlignCell}"/>
                    <DataGridTextColumn Header="ĐVT" Binding="{Binding DonVi}" Width="70" ElementStyle="{StaticResource CenterAlignCell}"/>
                    <DataGridTextColumn Header="SL" Binding="{Binding SoLuong}" Width="80" ElementStyle="{StaticResource CenterAlignCell}"/>
                    <DataGridTextColumn Header="Đơn giá" Binding="{Binding DonGia, StringFormat={}{0:N0} VND}" Width="140" ElementStyle="{StaticResource RightAlignCell}"/>
                    <DataGridTextColumn Header="Thành tiền" Binding="{Binding ThanhTien, StringFormat={}{0:N0} VND}" Width="160" ElementStyle="{StaticResource RightAlignCell}"/>

                    <DataGridTemplateColumn Header="Thao tác" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Xóa" Click="btnXoaSP_Click" Background="Transparent" Foreground="#E53E3E" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="4" Background="White" Margin="0,15,0,0" Padding="15,12" CornerRadius="8" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Tiền hàng:" Width="110" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtTienHang" Text="0 VND" FontWeight="Bold" Foreground="#333"/>
                        </StackPanel>
                        <StackPanel x:Name="pnlVAT" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="VAT (10%):" Width="110" Foreground="#666" FontWeight="SemiBold"/>
                            <TextBlock x:Name="lblTienVAT" Text="0 VND" FontWeight="Bold" Foreground="#4C70BA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="TỔNG CỘNG:" Width="110" FontSize="14" FontWeight="Bold" Foreground="#444" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTongCong" Text="0 VND" FontSize="22" FontWeight="Bold" Foreground="#E53E3E" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Button Content="Hủy bỏ" Click="btnHuy_Click" Width="100" Height="40" Margin="0,0,10,0" Background="#F1F3F5" Foreground="#555" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="LƯU THAY ĐỔI" Click="btnLuu_Click" Width="160" Height="40" Background="{StaticResource PrimaryBlue}" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>