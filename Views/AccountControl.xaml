<UserControl x:Class="PharmaDistributionApp.Views.AccountControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignFont}"
             TextElement.Foreground="#333333">

    <UserControl.Resources>
        <Style x:Key="ProfileTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="Transparent" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsReadOnly" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F5F6F8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="RevealInputBase" TargetType="Control">
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0,45,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="RevealPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource RevealInputBase}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RevealTextBox" TargetType="TextBox" BasedOn="{StaticResource RevealInputBase}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid x:Name="MainView" Margin="30,20,30,20" Visibility="Visible" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Tài khoản" FontSize="28" FontWeight="Bold" Foreground="#4C70BA" Margin="0,0,0,20"/>
            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="40" VerticalAlignment="Top">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.05" Color="Black"/>
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Ellipse Width="100" Height="100">
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="imgAvatar" ImageSource="/Images/default_avatar.jpg" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Button x:Name="btnChangeAvatar" Click="btnChangeAvatar_Click" Visibility="Collapsed" Style="{StaticResource MaterialDesignFloatingActionMiniButton}" Width="20" Height="20" Background="#4C70BA" BorderBrush="{x:Null}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5">
                                <materialDesign:PackIcon Kind="Camera" Width="10" Height="10"/>
                            </Button>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="25,0,0,0">
                            <TextBlock x:Name="lblDisplayName" Text="Tên Nhân Viên" FontSize="26" FontWeight="Regular"/>
                            <TextBlock x:Name="lblRole" Text="Chức vụ" FontSize="14" Foreground="Gray" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="btnEdit" Click="btnEdit_Click" Grid.Column="2" VerticalAlignment="Top" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#DDDDDD" Foreground="#666" materialDesign:ButtonAssist.CornerRadius="15" Height="32" Padding="15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Edit" FontWeight="Normal" FontSize="13"/>
                                <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Separator Background="#EEEEEE" Margin="0,0,0,25"/>
                    <TextBlock Text="Thông tin cá nhân" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Họ" Style="{StaticResource LabelTitle}"/>
                            <TextBox x:Name="txtHo" IsReadOnly="True" Style="{StaticResource ProfileTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="Tên" Style="{StaticResource LabelTitle}"/>
                            <TextBox x:Name="txtTen" IsReadOnly="True" Style="{StaticResource ProfileTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="0">
                            <TextBlock Text="Email" Style="{StaticResource LabelTitle}"/>
                            <TextBox x:Name="txtEmail" IsReadOnly="True" Style="{StaticResource ProfileTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Số điện thoại" Style="{StaticResource LabelTitle}"/>
                            <TextBox x:Name="txtPhone" IsReadOnly="True" Style="{StaticResource ProfileTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="0">
                            <TextBlock Text="Địa chỉ" Style="{StaticResource LabelTitle}"/>
                            <TextBox x:Name="txtAddress" IsReadOnly="True" Style="{StaticResource ProfileTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2">
                            <TextBlock Text="Ngày sinh" Style="{StaticResource LabelTitle}"/>
                            <Grid>
                                <TextBox x:Name="txtDobDisplay" IsReadOnly="True" Style="{StaticResource ProfileTextBox}"/>
                                <Border x:Name="bdDob" BorderThickness="0" CornerRadius="8">
                                    <DatePicker x:Name="dpDob" Visibility="Collapsed" materialDesign:TextFieldAssist.UnderlineBrush="#4C70BA" BorderThickness="0" Padding="0,5" FontSize="14"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Separator Background="#EEEEEE" Margin="0,30,0,25"/>
                    <StackPanel x:Name="secPassword">
                        <TextBlock Text="Mật khẩu" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox IsEnabled="False" PasswordChar="●" Password="password123" Background="Transparent" BorderThickness="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="btnSwitchToPassword" Click="btnSwitchToPassword_Click" Content="Đổi mật khẩu" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#DDDDDD" Foreground="#555" FontWeight="SemiBold" materialDesign:ButtonAssist.CornerRadius="15" Height="32"/>
                        </Grid>
                    </StackPanel>
                    <TextBlock x:Name="txbMainError" Text="Thông tin không hợp lệ" Foreground="#D32F2F" FontSize="13" FontStyle="Italic" HorizontalAlignment="Right" Margin="0,5,10,0" Visibility="Collapsed"/>
                    <Button x:Name="btnSave" Click="btnSave_Click" Content="Lưu" Width="100" HorizontalAlignment="Right" Margin="0,5,0,0" Visibility="Collapsed" Background="#4C70BA" BorderBrush="{x:Null}" materialDesign:ButtonAssist.CornerRadius="10" Height="40" FontSize="16" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="PasswordView" Margin="30,20,30,20" Visibility="Collapsed" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Đổi mật khẩu" FontSize="28" FontWeight="Bold" Foreground="#4C70BA" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Background="White" CornerRadius="15" Padding="50" 
                    VerticalAlignment="Top" HorizontalAlignment="Center" Width="650">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.05" Color="Black"/>
                </Border.Effect>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                        <materialDesign:PackIcon Kind="Cached" Width="28" Height="28" Foreground="#4C70BA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="THAY ĐỔI MẬT KHẨU" FontSize="22" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Mật khẩu hiện tại" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <PasswordBox x:Name="pbOldPass" Style="{StaticResource RevealPasswordBox}"/>
                        <TextBox x:Name="txtOldPass" Style="{StaticResource RevealTextBox}" Visibility="Collapsed"/>
                        <Button Click="ToggleEye_Click" Tag="Old" Style="{StaticResource EyeButtonStyle}">
                            <materialDesign:PackIcon x:Name="iconEyeOld" Kind="EyeOff"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Mật khẩu mới" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <PasswordBox x:Name="pbNewPass" Style="{StaticResource RevealPasswordBox}"/>
                        <TextBox x:Name="txtNewPass" Style="{StaticResource RevealTextBox}" Visibility="Collapsed"/>
                        <Button Click="ToggleEye_Click" Tag="New" Style="{StaticResource EyeButtonStyle}">
                            <materialDesign:PackIcon x:Name="iconEyeNew" Kind="EyeOff"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="Xác nhận mật khẩu" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,20">
                        <PasswordBox x:Name="pbConfirmPass" Style="{StaticResource RevealPasswordBox}"/>
                        <TextBox x:Name="txtConfirmPass" Style="{StaticResource RevealTextBox}" Visibility="Collapsed"/>
                        <Button Click="ToggleEye_Click" Tag="Confirm" Style="{StaticResource EyeButtonStyle}">
                            <materialDesign:PackIcon x:Name="iconEyeConfirm" Kind="EyeOff"/>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="txbError" Text="Lỗi" Foreground="#D32F2F" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center" Margin="0,0,0,15" Visibility="Collapsed"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnCancelPassword" Click="btnCancelPassword_Click"
                                Grid.Column="0" Content="Hủy"
                                Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Foreground="#555"
                                materialDesign:ButtonAssist.CornerRadius="10" Height="45" FontSize="16"/>

                        <Button x:Name="btnSavePassword" Click="btnSavePassword_Click"
                                Grid.Column="2" Content="Đổi mật khẩu"
                                Background="#4C70BA" BorderBrush="{x:Null}"
                                materialDesign:ButtonAssist.CornerRadius="10" Height="45" FontSize="16" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>