<UserControl x:Class="PharmaDistributionApp.Views.VerifyCodeWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="White"
             FontFamily="{DynamicResource MaterialDesignFont}"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}">

    <Grid>
        <StackPanel VerticalAlignment="Center" Margin="60,0">

            <TextBlock Text="NHẬP MÃ XÁC MINH" 
                       FontSize="24" FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       Foreground="#4C70BA" 
                       Margin="0,0,0,10"/>

            <TextBlock Text="Chúng tôi đã gửi mã xác minh về Email của bạn. Mã sẽ hết hạn trong vòng 5 phút." 
                       Foreground="Gray" TextWrapping="Wrap" 
                       HorizontalAlignment="Center" TextAlignment="Center"
                       Margin="0,0,0,30" FontSize="14"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                <StackPanel.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                        <Setter Property="Width" Value="50"/>
                        <Setter Property="Height" Value="60"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="FontSize" Value="24"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="0,10,0,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="MaxLength" Value="1"/>
                        <Setter Property="BorderBrush" Value="#DDDDDD"/>
                        <Style.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#4267B2"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Resources>

                <TextBox x:Name="txtC1" TextChanged="TxtCode_TextChanged"/>
                <TextBox x:Name="txtC2" TextChanged="TxtCode_TextChanged"/>
                <TextBox x:Name="txtC3" TextChanged="TxtCode_TextChanged"/>
                <TextBox x:Name="txtC4" TextChanged="TxtCode_TextChanged"/>
                <TextBox x:Name="txtC5" TextChanged="TxtCode_TextChanged"/>
                <TextBox x:Name="txtC6" TextChanged="TxtCode_TextChanged"/>
            </StackPanel>

            <Button x:Name="btnConfirm" Content="XÁC NHẬN" Height="50" FontSize="18" FontWeight="Bold" 
                    Background="#4C70BA" BorderBrush="{x:Null}" 
                    materialDesign:ButtonAssist.CornerRadius="10"
                    Click="btnConfirm_Click"/>

            <Button Content="Quay lại" 
                    Style="{StaticResource MaterialDesignFlatButton}" 
                    Foreground="Gray" Margin="0,10,0,0"
                    Click="btnBack_Click"/>
        </StackPanel>
    </Grid>
</UserControl>