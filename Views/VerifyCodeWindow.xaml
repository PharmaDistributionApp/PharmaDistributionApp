<Window x:Class="PharmaDistributionApp.Views.VerifyCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Verify Code" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Primary/MaterialDesignColor.DeepPurple.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignColors;component/Themes/Recommended/Accent/MaterialDesignColor.Lime.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="6*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#90B0D5" CornerRadius="20,0,0,20"/>

        <Border Grid.Column="1" Background="White" CornerRadius="30,0,20,0" Margin="-30,0,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" Margin="60,0">
                <TextBlock Text="Nhập mã xác minh" FontSize="28" FontWeight="Bold" Foreground="#4267B2" Margin="0,0,0,10"/>
                <TextBlock Text="Chúng tôi đã gửi mã xác minh về Email của bạn, mã sẽ hết hạn trong vòng 5 phút." 
                           Foreground="#90B0D5" TextWrapping="Wrap" Margin="0,0,0,30" FontSize="14"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,40">
                    <StackPanel.Resources>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                            <Setter Property="Width" Value="50"/>
                            <Setter Property="Height" Value="60"/>
                            <Setter Property="Margin" Value="5"/>
                            <Setter Property="FontSize" Value="24"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Padding" Value="0,10,0,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="MaxLength" Value="1"/>
                            <Setter Property="BorderBrush" Value="Gray"/>
                        </Style>
                    </StackPanel.Resources>

                    <TextBox x:Name="txtC1" TextChanged="TxtCode_TextChanged"/>
                    <TextBox x:Name="txtC2" TextChanged="TxtCode_TextChanged"/>
                    <TextBox x:Name="txtC3" TextChanged="TxtCode_TextChanged"/>
                    <TextBox x:Name="txtC4" TextChanged="TxtCode_TextChanged"/>
                    <TextBox x:Name="txtC5" TextChanged="TxtCode_TextChanged"/>
                    <TextBox x:Name="txtC6" TextChanged="TxtCode_TextChanged"/>
                </StackPanel>

                <Button x:Name="btnConfirm" Content="Xác Nhận" Height="50" FontSize="18" FontWeight="Bold" 
                        Background="#4C70BA" BorderBrush="{x:Null}" Click="btnConfirm_Click">
                    <Button.Resources>
                        <CornerRadius x:Key="ButtonCornerRadius">25</CornerRadius>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
        <Button Grid.Column="1"
            HorizontalAlignment="Right" 
            VerticalAlignment="Top"
            Margin="0,10,15,0"
            Width="30" Height="30"
            Style="{StaticResource MaterialDesignIconForegroundButton}"
            ToolTip="Thoát ứng dụng"
            Click="btnExit_Click">
        
        <materialDesign:PackIcon Kind="Close" Width="20" Height="20" Foreground="Gray"/>
    </Button>
    </Grid>
</Window>