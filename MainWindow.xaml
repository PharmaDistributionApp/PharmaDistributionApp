<Window x:Class="PharmaDistributionApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:views="clr-namespace:PharmaDistributionApp.Views"
        mc:Ignorable="d"
        Title="Hệ thống Quản lý Dược phẩm" 
        Height="768" Width="1280"
        WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource MaterialDesignFont}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Background="{DynamicResource MaterialDesignPaper}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#4C70BA">
            <StackPanel>

                <Grid Margin="20,30,20,40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="AccountCircleOutline" Width="45" Height="45" Foreground="White" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,5,0">
                        <TextBlock x:Name="txbUserName" Text="Đang tải..." Foreground="White" FontWeight="Bold" FontSize="15" TextWrapping="Wrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock x:Name="txbUserRole" Text="Online" Foreground="#AAC4FF" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <materialDesign:PackIcon Grid.Column="2" Kind="ChevronDown" Foreground="White" VerticalAlignment="Center"/>
                </Grid>

                <Border x:Name="btnAccount" Tag="Account" MouseLeftButtonDown="Menu_Click" Cursor="Hand"
                        Background="White" Margin="10,0,0,5" CornerRadius="10,0,0,10" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountOutline" Foreground="#4C70BA" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Tài khoản" Foreground="#4C70BA" FontWeight="Bold" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="btnKho" Tag="Kho" MouseLeftButtonDown="Menu_Click" Cursor="Hand"
                        Background="Transparent" Margin="10,0,0,5" CornerRadius="10,0,0,10" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PackageVariant" Foreground="White" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Kho" Foreground="White" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="btnNhanSu" Tag="NhanSu" MouseLeftButtonDown="Menu_Click" Cursor="Hand"
                        Background="Transparent" Margin="10,0,0,5" CornerRadius="10,0,0,10" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountGroupOutline" Foreground="White" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Nhân sự" Foreground="White" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="btnHoaDon" Tag="HoaDon" MouseLeftButtonDown="Menu_Click" Cursor="Hand"
                        Background="Transparent" Margin="10,0,0,5" CornerRadius="10,0,0,10" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Receipt" Foreground="White" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Hóa đơn" Foreground="White" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border x:Name="btnNhaCungCap" Tag="NhaCungCap" MouseLeftButtonDown="Menu_Click" Cursor="Hand"
                        Background="Transparent" Margin="10,0,0,5" CornerRadius="10,0,0,10" Padding="15">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="StoreOutline" Foreground="White" Width="22" Height="22" VerticalAlignment="Center"/>
                        <TextBlock Text="Nhà cung cấp" Foreground="White" FontSize="15" Margin="15,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Button Background="Transparent" BorderBrush="{x:Null}" Margin="10,100,0,5" Padding="15" HorizontalContentAlignment="Left">
                    <TextBlock Text="Đăng xuất" Foreground="#AAC4FF" FontWeight="SemiBold" FontSize="14" Margin="52,0,0,0"/>
                </Button>

            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Background="#F0F2F5">
            <ContentControl x:Name="MainContent"/>
        </Grid>
    </Grid>
</Window>